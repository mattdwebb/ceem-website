---
import Layout from "./Layout.astro";
import PageIntro from "./PageIntro.astro";

import { getMembershipLabel, people } from "../data/people";
import { getDictionary } from "../data/site";
import type { Locale, RoleGroup } from "../data/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const groups: RoleGroup[] = [
  "director",
  "coDirectors",
  "members",
  "graduateStudents",
];
---

<Layout
  locale={locale}
  routeKey="team"
  title={dict.pageTitles.team}
  description={dict.pageIntro.team}
>
  <PageIntro title={dict.pageTitles.team} intro={dict.pageIntro.team} />

  {
    groups.map((group) => {
      const members = people
        .filter((person) => person.roleGroup === group)
        .sort((left, right) => left.sortOrder - right.sortOrder);

      return (
        <section class="content-section">
          <div class="content-section__header">
            <h2>{dict.team[group]}</h2>
          </div>

          <div class="profile-grid">
            {members.map((member) => (
              <article class="profile-card">
                <p class="profile-card__role">
                  {group === "director"
                    ? dict.team.director
                    : group === "coDirectors"
                      ? locale === "fr" ? "Codirecteur" : "Co-Director"
                      : group === "graduateStudents"
                        ? dict.team.graduateStudent
                        : getMembershipLabel(locale, member.memberships)}
                </p>
                <h3>{member.name}</h3>
                <p class="profile-card__affiliation">{member.affiliation}</p>
                {group !== "members" && (
                  <p class="profile-card__membership">{getMembershipLabel(locale, member.memberships)}</p>
                )}
                <p>{locale === "fr" ? member.bioFr : member.bioEn}</p>
                {member.profileUrl && (
                  <a class="text-link" href={member.profileUrl} target="_blank" rel="noreferrer">
                    {dict.learnMore}
                  </a>
                )}
              </article>
            ))}
          </div>
        </section>
      );
    })
  }
</Layout>
